# ============================================================
# Git LFS — büyük ikili dosyalar burada takip edilir, normal git
# geçmişini şişirmesinler diye. Herkesin `git lfs install` çalıştırmış
# olması gerekir (bkz. README kurulum adımları).
# ============================================================

# VRAG referans görselleri (data/referans/) artık .gitignore'da — ham kaynak
# veri repo'yu şişiriyordu, indekslenmiş hali (aşağıdaki qdrant_db) yeterli.

# İndekslenmiş VRAG vektör veritabanı (Qdrant embedded/local)
output/qdrant_db/** filter=lfs diff=lfs merge=lfs -text

# YOLO model ağırlıkları
models/*.pt filter=lfs diff=lfs merge=lfs -text

# LLM metin gömme (embedding) modeli — RAG için yerel bundle edilmiş
karar_servisi/data/models/qwen3-embedding-0.6b/*.safetensors filter=lfs diff=lfs merge=lfs -text
karar_servisi/data/models/qwen3-embedding-0.6b/tokenizer.json filter=lfs diff=lfs merge=lfs -text
karar_servisi/data/models/qwen3-embedding-0.6b/vocab.json filter=lfs diff=lfs merge=lfs -text
karar_servisi/data/models/qwen3-embedding-0.6b/merges.txt filter=lfs diff=lfs merge=lfs -text
