<Window x:Class="Kokpit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UAV Kokpit — Hava Aracı Tespit ve Tanıma"
        Height="800" Width="1300" MinHeight="560" MinWidth="980"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Zemin}" KeyDown="Pencere_KeyDown">

    <Window.Resources>
        <!-- Aday güven çubuğu şablonu (canlı kart + test paylaşır) -->
        <DataTemplate x:Key="AdayCubuk">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Height="22" Background="#0B0E13" CornerRadius="5"/>
                <Border Grid.Column="0" Height="22" HorizontalAlignment="Left" CornerRadius="5"
                        Background="{StaticResource Vurgu}" Opacity="0.30"
                        Width="{Binding Skor, Converter={StaticResource OranGenislik}, ConverterParameter=250}"/>
                <TextBlock Grid.Column="0" Text="{Binding Model}" VerticalAlignment="Center"
                           Margin="9,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Skor, StringFormat={}{0:P0}}"
                           VerticalAlignment="Center" Margin="6,0,9,0" FontSize="12"
                           FontWeight="SemiBold" Foreground="{StaticResource Solgun}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ÜST ŞERİT -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Cizgi}"
                BorderThickness="0,0,0,1" Padding="16,11">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◆ UAV KOKPİT" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Vurgu}" VerticalAlignment="Center" Margin="0,0,22,0"/>
                    <Button Content="Video Aç" Command="{Binding VideoAcCommand}"/>
                    <Button Content="▶ Başlat" Style="{StaticResource Vurgulu}"
                            Command="{Binding BaslatCommand}" IsEnabled="{Binding BackendHazir}"/>
                    <Button Content="■ Durdur" Command="{Binding DurdurCommand}" IsEnabled="{Binding Calisiyor}"/>
                    <Border Width="1" Background="{StaticResource Cizgi}" Margin="6,2,14,2"/>
                    <Button Content="🔍 Foto Test" Command="{Binding FotoTestCommand}"
                            IsEnabled="{Binding BackendHazir}"/>
                    <TextBlock Text="{Binding VideoYolu}" Foreground="{StaticResource Solgun}"
                               VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Solgun}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BackendHazir}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Basari}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ModelSayisi, StringFormat='{}{0} model'}"
                               Foreground="{StaticResource Solgun}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ORTA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="410"/>
            </Grid.ColumnDefinitions>

            <!-- Video + test overlay -->
            <Border Grid.Column="0" Background="#05070A" Margin="14" CornerRadius="10"
                    BorderBrush="{StaticResource Cizgi}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="Video seçin ve Başlat'a basın" Foreground="{StaticResource Solgun}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    <Image Source="{Binding KareGoruntu}" Stretch="Uniform" Margin="6"/>

                    <!-- TEK-GÖRSEL TEST SONUCU (overlay) -->
                    <Border Visibility="{Binding TestSonuc, Converter={StaticResource NullGizle}}"
                            Background="#F00E1217" CornerRadius="10" Padding="22"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="640" BorderBrush="{StaticResource Vurgu}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="TEK-GÖRSEL TEST" Style="{StaticResource Baslik}" VerticalAlignment="Center"/>
                                <Button Content="✕ Kapat" Command="{Binding TestKapatCommand}"
                                        HorizontalAlignment="Right" Padding="10,4" FontSize="11" Margin="0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="SORGU" Style="{StaticResource Baslik}"/>
                                    <Border CornerRadius="6" ClipToBounds="True" Background="#0B0E13">
                                        <Image Source="{Binding TestGoruntu}" Stretch="Uniform" MaxHeight="200"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                            Visibility="{Binding TestReferans, Converter={StaticResource NullGizle}}">
                                    <TextBlock Text="EŞLEŞEN REFERANS" Style="{StaticResource Baslik}"/>
                                    <Border CornerRadius="6" ClipToBounds="True" Background="#0B0E13">
                                        <Image Source="{Binding TestReferans}" Stretch="Uniform" MaxHeight="200"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding TestSonuc.GoruntuModel}" FontSize="22" FontWeight="Bold"
                                       Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,2,0,8" Foreground="{StaticResource Solgun}" FontSize="13">
                                <Run Text="{Binding TestSonuc.Ulke}"/><Run Text="  ·  "/><Run Text="{Binding TestSonuc.Rol}"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding TestSonuc.Adaylar}"
                                          ItemTemplate="{StaticResource AdayCubuk}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Sağ panel -->
            <Grid Grid.Column="1" Margin="0,14,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- VRAG ve VLM kartı (Secili model kartı) -->
                <Border Grid.Row="0" Margin="0,0,0,10" Background="{StaticResource Panel}" CornerRadius="10"
                        BorderBrush="{StaticResource Cizgi}" BorderThickness="1" Padding="14"
                        Visibility="{Binding SeciliHedef, Converter={StaticResource NullGizle}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SeciliHedef.GoruntuModel}" FontSize="20"
                                   FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource Solgun}" FontSize="13">
                            <Run Text="{Binding SeciliHedef.Ulke}"/><Run Text="  ·  "/><Run Text="{Binding SeciliHedef.Rol}"/>
                        </TextBlock>

                        <!-- Eşleşen referans fotoğrafı -->
                        <StackPanel Visibility="{Binding ReferansGoruntu, Converter={StaticResource NullGizle}}">
                            <TextBlock Text="EŞLEŞEN REFERANS" Style="{StaticResource Baslik}" Margin="2,12,0,6"/>
                            <Border CornerRadius="7" ClipToBounds="True" Background="#0B0E13">
                                <Image Source="{Binding ReferansGoruntu}" Stretch="Uniform" MaxHeight="150"/>
                            </Border>
                        </StackPanel>

                        <!-- Kinematik -->
                        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Solgun}">
                            <Run Text="benzerlik "/><Run Text="{Binding SeciliHedef.ModelSkor, StringFormat='{}{0:P0}'}"
                                 Foreground="{StaticResource Basari}" FontWeight="Bold"/>
                            <Run Text="    hız "/><Run Text="{Binding SeciliHedef.HizPxS, StringFormat='{}{0:F0}px/s'}" Foreground="{StaticResource Metin}"/>
                            <Run Text="    zigzag "/><Run Text="{Binding SeciliHedef.Zigzag, StringFormat='{}{0:F2}'}" Foreground="{StaticResource Metin}"/>
                            <Run Text="    hit "/><Run Text="{Binding SeciliHedef.Hits}" Foreground="{StaticResource Metin}"/>
                        </TextBlock>

                        <Border Margin="0,10,0,0" Background="#3A2E12" CornerRadius="6" Padding="9,5"
                                Visibility="{Binding SeciliHedef.DusukGuven, Converter={StaticResource DusukGuvenGorunur}}">
                            <TextBlock Text="⚠ Düşük güven — ilk iki aday çok yakın, kesin model belirsiz"
                                       Foreground="{StaticResource Uyari}" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="{Binding SeciliHedef.AdaylarBaslik}" Style="{StaticResource Baslik}" Margin="2,12,0,6"/>
                        <ItemsControl ItemsSource="{Binding SeciliHedef.Adaylar}"
                                      ItemTemplate="{StaticResource AdayCubuk}"/>


                    </StackPanel>
                </Border>

                <!-- VLM KARTI -->
                <Border Grid.Row="1" Margin="0,0,0,10" CornerRadius="12"
                        BorderThickness="1" Padding="0"
                        Visibility="{Binding SeciliHedef.VlmVar, Converter={StaticResource DusukGuvenGorunur}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#151A22"/>
                            <Setter Property="BorderBrush" Value="#2D3342"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SeciliHedef.Vlm.TehditSeviyesi}" Value="yuksek">
                                    <Setter Property="BorderBrush" Value="#C0392B"/>
                                    <Setter Property="Background" Value="#2A0B0B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SeciliHedef.Vlm.TehditSeviyesi}" Value="orta">
                                    <Setter Property="BorderBrush" Value="#E67E22"/>
                                    <Setter Property="Background" Value="#251608"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <!-- Cam efekti icin hafif overlay -->
                        <Border CornerRadius="11" Background="#05FFFFFF" IsHitTestVisible="False"/>
                        
                        <StackPanel Margin="16">
                            <!-- Baslik + Tehdit rozeti -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👁️" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="GÖRSEL İSTİHBARAT (VLM)" Style="{StaticResource Baslik}" VerticalAlignment="Center" Margin="0"/>
                                </StackPanel>
                                
                                <Border Grid.Column="1" CornerRadius="4" Padding="10,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2D3342"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SeciliHedef.Vlm.TehditSeviyesi}" Value="yuksek">
                                                    <Setter Property="Background" Value="#C0392B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SeciliHedef.Vlm.TehditSeviyesi}" Value="orta">
                                                    <Setter Property="Background" Value="#E67E22"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SeciliHedef.Vlm.TehditSeviyesi}" Value="dusuk">
                                                    <Setter Property="Background" Value="#27AE60"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SeciliHedef.Vlm.TehditSeviyesi}" Value="yok">
                                                    <Setter Property="Background" Value="#2D3342"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SeciliHedef.Vlm.TehditSeviyesi}" 
                                               FontSize="11" FontWeight="Bold" Foreground="White" 
                                               TextAlignment="Center" MinWidth="45"/>
                                </Border>
                            </Grid>

                            <!-- Tespit / Sinif satiri -->
                            <Border Background="#0DFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#15FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Hedef Modeli:" 
                                               Foreground="{StaticResource Solgun}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SeciliHedef.Vlm.GercekTahmin}" 
                                               FontWeight="Bold" Foreground="{StaticResource Vurgu}" FontSize="14" TextWrapping="Wrap"/>
                                               
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Araç Sınıfı:" 
                                               Foreground="{StaticResource Solgun}" FontSize="12" Margin="0,6,10,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SeciliHedef.Vlm.AracSinifi}" 
                                               Foreground="{StaticResource Basari}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Gorsel Analiz metni -->
                            <TextBlock Text="Analiz Raporu" Foreground="{StaticResource Solgun}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border Background="#090B0E" CornerRadius="8" Padding="12,10" BorderBrush="#1C212B" BorderThickness="1">
                                <TextBlock Text="{Binding SeciliHedef.Vlm.GorselAnaliz}" 
                                           TextWrapping="Wrap" FontSize="13" 
                                           Foreground="#E2E8F0" 
                                           LineHeight="20"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>


                <!-- LLM -->
                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10"
                        BorderBrush="{StaticResource Cizgi}" BorderThickness="1" Padding="14"
                        Visibility="{Binding SeciliHedef.LlmVar, Converter={StaticResource DusukGuvenGorunur}}">
                    <StackPanel>
                        <TextBlock Text="STRATEJİK ANALİZ (LLM)" Style="{StaticResource Baslik}" Margin="2,0,0,10"/>
                        <Border Background="#1A1C23" CornerRadius="8" Padding="15" BorderBrush="#2D3342" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Risk Seviyesi:" Foreground="{StaticResource Solgun}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SeciliHedef.Llm.Risk}" FontWeight="Bold" Foreground="#E74C3C" FontSize="14"/>
                                </Grid>
                                
                                <TextBlock Text="Özet Rapor" Foreground="{StaticResource Solgun}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SeciliHedef.Llm.Summary}" TextWrapping="Wrap" FontSize="13" Foreground="#E2E8F0" Margin="0,0,0,12" LineHeight="20"/>

                                <TextBlock Text="Önerilen Aksiyonlar" Foreground="{StaticResource Solgun}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding SeciliHedef.Llm.Actions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="•" Foreground="{StaticResource Vurgu}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding}" Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ALT DURUM ŞERİDİ -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Cizgi}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock Text="{Binding DurumMetni}" Foreground="{StaticResource Solgun}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
